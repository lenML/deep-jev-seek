{
  "name": "@lenml/jevseek-server",
  "version": "0.1.0",
  "private": true,
  "description": "Bun HTTP adapter for Jev-compatible DeepSeek FIM requests",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "test": "node scripts/static-check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lenml/jevseek": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
