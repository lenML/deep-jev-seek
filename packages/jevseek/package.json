{
  "name": "@lenml/jevseek",
  "version": "0.1.0",
  "description": "Jev-compatible SystemOne API backed by DeepSeek FIM",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek",
    "fim",
    "jev",
    "logprobs",
    "systemone",
    "typescript"
  ],
  "homepage": "https://github.com/lenML/deep-jev-seek#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenML/deep-jev-seek.git",
    "directory": "packages/jevseek"
  },
  "bugs": {
    "url": "https://github.com/lenML/deep-jev-seek/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "npm:login": "npm login --registry=https://registry.npmjs.org/ --auth-type=web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
